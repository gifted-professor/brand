# Spark 火花 — copy to .env.local; restart the local service after editing.
# Server-side only. Never use a VITE_ prefix for secrets.

# Text collaboration uses this computer's existing CLI login.
# You can also select a CLI and model from the canvas header.
COLLIDER_AGENT_TRANSPORT=codex-cli
CODEX_CLI_MODEL=gpt-5.5
# CODEX_CLI_BIN=codex
# GROK_CLI_MODEL=grok-4.6
# GROK_CLI_BIN=grok

# Optional image service. Replace BOTH placeholders to enable real images.
# Requires streaming POST /v1/responses with the image_generation tool.
OPENAI_PROVIDER=openai-compatible
OPENAI_BASE_URL=https://your-image-service.example/v1
OPENAI_API_KEY=replace-with-your-key
IMAGE_MODEL=gpt-image-2
# Set a Responses model actually supported by your image service.
IMAGE_RESPONSES_MODEL=gpt-5.5
IMAGE_REASONING_EFFORT=auto
IMAGE_OPTIMIZE_REFERENCES=true
IMAGE_TIMEOUT_MS=780000
IMAGE_FINAL_IMAGE_GRACE_MS=1000

# Optional: only for users who have already configured their own remote-cpa helper.
# OPENAI_PROVIDER=cpa
# Optional proxy: configure your own local proxy if required; no proxy is bundled.
# HTTPS_PROXY=http://127.0.0.1:YOUR_PORT
# HTTP_PROXY=http://127.0.0.1:YOUR_PORT
# NO_PROXY=127.0.0.1,localhost
