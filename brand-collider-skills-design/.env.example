# Agent processes use local Codex login by default; no app text API key is needed.
COLLIDER_AGENT_TRANSPORT=codex-cli
CODEX_CLI_MODEL=gpt-6-astra
# CODEX_CLI_BIN=codex
# CODEX_CLI_TIMEOUT_MS=600000
# Set COLLIDER_AGENT_TRANSPORT=api only to explicitly use the legacy text adapter.
# The following provider configuration is still used by the image-generation tool.

# Server-side only. Copy to .env.local; never expose these to a browser.
# Set cpa to use ~/.codex/remote-cpa.local.json and the installed remote-cpa helper.
# CPA credentials are retrieved into memory; do not put a CPA key in this file.
OPENAI_PROVIDER=cpa
# The following gateway URL/key are used only with openai-compatible.
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=replace-with-your-key
# Brand dialogue model. Kept separate from image generation.
OPENAI_MODEL=gpt-6-astra
# Optional text request limits. These defaults include the structured output budget.
# TEXT_MAX_TOKENS=16384
# TEXT_TIMEOUT_MS=180000
# TEXT_REASONING_EFFORT=low
# Responses orchestration and the image tool are separate models.
IMAGE_RESPONSES_MODEL=gpt-5.5
# Low-effort orchestration; auto omits the reasoning parameter for gateway compatibility.
IMAGE_REASONING_EFFORT=low
IMAGE_MODEL=gpt-image-2
IMAGE_OPTIMIZE_REFERENCES=true
# After a final image, wait at most 1s for tail events. 0 waits for HTTP/response completion.
IMAGE_FINAL_IMAGE_GRACE_MS=1000
IMAGE_TIMEOUT_MS=780000
IMAGE_OUTPUT_DIR=./outputs/images
# Optional verified IP override when this machine's DNS cannot resolve the gateway.
# Original Host/SNI and TLS certificate verification are retained. No global DNS changes.
# IMAGE_CONNECT_IP=
